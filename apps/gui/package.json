{
  "name": "crossagents-gui",
  "private": true,
  "version": "0.3.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview:mock": "vite --mode mock",
    "screenshot": "node scripts/screenshot.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri:dev": "tauri dev",
    "tauri:build": "tsc --noEmit && vite build --mode tauri --outDir dist-tauri && cargo build --release --locked --manifest-path src-tauri/Cargo.toml",
    "tauri:bundle": "node scripts/tauri-bundle.mjs",
    "tauri:update-manifest": "node scripts/tauri-update-manifest.mjs",
    "test": "node --test \"src/lib/*.test.ts\" \"src/extensions/*.test.ts\" && node --test scripts/packaging.test.mjs",
    "test:browser": "node scripts/browser-regression.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lobehub/icons-static-svg": "1.101.0",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^1.61.0",
    "mermaid": "12.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  },
  "description": "CrossAgents desktop GUI (Tauri), a pure client of the hub API",
  "dependencies": {
    "htm": "^3.1.1"
  }
}
