{
  "name": "crossagents-gui",
  "private": true,
  "version": "0.1.10",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview:mock": "vite --mode mock",
    "screenshot": "node scripts/screenshot.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p electron --noEmit",
    "test": "node --test \"src/lib/*.test.ts\" && tsc -p electron && node --test \"dist-electron/*.test.cjs\"",
    "electron:compile": "tsc -p electron",
    "electron:dev": "npm run electron:compile && concurrently -k -n vite,electron \"vite\" \"electron . --dev-server-url=http://localhost:1420\"",
    "electron:build": "node scripts/check-version.mjs && cargo build --release -p crossagents-cli && npm run build && npm run electron:compile && electron-builder --win --publish never",
    "electron:release": "node scripts/check-version.mjs && cargo build --release -p crossagents-cli && npm run build && npm run electron:compile && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "10.0.5",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  },
  "description": "CrossAgents desktop GUI, a pure client of the hub API",
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "dev.crossagents.gui",
    "productName": "CrossAgents",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!dist-electron/*.test.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "../../target/release/crossagents.exe",
        "to": "bin/crossagents.exe"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "L1nkkkk",
        "repo": "CrossAgents-releases",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  }
}
