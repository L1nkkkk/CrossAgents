{
  "name": "crossagents-gui",
  "private": true,
  "version": "0.2.29",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview:mock": "vite --mode mock",
    "screenshot": "node scripts/screenshot.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit && tsc -p electron --noEmit",
    "test": "node --test \"src/lib/*.test.ts\" \"src/extensions/*.test.ts\" && tsc -p electron && node --test scripts/packaging.test.mjs && node --test \"dist-electron/*.test.cjs\"",
    "electron:compile": "tsc -p electron",
    "electron:dev": "npm run electron:compile && concurrently -k -n vite,electron \"vite\" \"electron . --dev-server-url=http://localhost:1420\"",
    "electron:build": "cargo build --release -p crossagents-cli -p crossagents-link && node scripts/check-version.mjs && npm run build && npm run electron:compile && electron-builder --win --publish never",
    "electron:release": "cargo build --release -p crossagents-cli -p crossagents-link && node scripts/check-version.mjs && npm run build && npm run electron:compile && electron-builder --win --publish always",
    "electron:build:mac": "cargo build --release -p crossagents-link && node scripts/check-version.mjs --without-hub && npm run build && npm run electron:compile && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@lobehub/icons-static-svg": "1.101.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "concurrently": "10.0.5",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  },
  "description": "CrossAgents desktop GUI, a pure client of the hub API",
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "dev.crossagents.gui",
    "productName": "CrossAgents",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!dist-electron/*.test.cjs",
      "!dist-electron/fakeSsh.cjs",
      "!dist-electron/fakeLink.cjs",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "extraResources": [
        {
          "from": "../../target/release/crossagents.exe",
          "to": "bin/crossagents.exe"
        },
        {
          "from": "../../target/release/crossagents-link.exe",
          "to": "bin/crossagents-link.exe"
        },
        {
          "from": "build/icon.ico",
          "to": "icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "L1nkkkk",
        "repo": "CrossAgents-releases",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "notarize": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "../../target/release/crossagents-link",
          "to": "bin/crossagents-link"
        },
        {
          "from": "build/iconTemplate.png",
          "to": "iconTemplate.png"
        },
        {
          "from": "build/iconTemplate@2x.png",
          "to": "iconTemplate@2x.png"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "6.8.10",
    "htm": "^3.1.1",
    "mermaid": "12.2.0"
  }
}
